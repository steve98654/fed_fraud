---
// DOD-1 / DOD-2 wireframe: set-aside contractor integrity screen. Sample data only.
import Frame from './Frame.astro';

const rows = [
  { id: 'V-7A31', prog: '8(a)', reg: '2021', amt: '$48.2M', score: 92, sig: ['New entity', 'POC = large firm', '81% subawarded'] },
  { id: 'V-2C08', prog: 'SDVOSB', reg: '2020', amt: '$31.5M', score: 88, sig: ['81% subawarded', 'Address = large firm'] },
  { id: 'V-9F14', prog: 'HUBZone', reg: '2022', amt: '$22.9M', score: 84, sig: ['New entity', 'Excluded link'] },
  { id: 'V-4B77', prog: 'WOSB', reg: '2019', amt: '$17.4M', score: 76, sig: ['Bidder ring B-3'] },
  { id: 'V-5D20', prog: '8(a)', reg: '2018', amt: '$12.1M', score: 71, sig: ['Just-under awards'] },
];

// Sole-source award counts by value band; the band just under the threshold spikes.
const bins = [14, 18, 16, 15, 13, 12, 11, 12, 10, 31, 3, 2, 2, 1];
const binW = 26;

// Win rotation: quarter-by-quarter winners in one market.
const rotation = ['A', 'B', 'C', 'A', 'B', 'C', 'A', 'B', 'C', 'A', 'B', 'C'];
const rotColor: Record<string, string> = { A: 'var(--risk-hi)', B: 'var(--risk-md)', C: 'var(--geoblue)' };

const notes = [
  { title: 'Ranked vendors', text: 'Every set-aside vendor in the chosen market, scored on front and pass-through signals, with the reasons shown as tags.' },
  { title: 'Vendor timeline', text: 'Registration, certification and award history. Firms that win large awards within months of registering are compared with peers in the same program.' },
  { title: 'Where the money goes', text: 'Subaward reports traced to the firms doing the work. Services set-asides cap what can go to ineligible subcontractors, so a large share to one ineligible firm is a pass-through signal.' },
  { title: 'Bidder network', text: 'Bidders in the same market that share officers, addresses or phone numbers, and whether they take turns winning. These leads go to the Procurement Collusion Strike Force.' },
  { title: 'Threshold gaming', text: 'Sole-source awards by value. A pile-up just under a competition threshold points to contract splitting.' },
  { title: 'Lead package', text: 'Selected vendors export with award IDs, sources and caveats, for DCIS, DoD OIG or the Office of Small Business Programs.' },
];
---

<Frame
  app="Set-aside contractor integrity screen"
  ideas={['DOD-1', 'DOD-2']}
  notes={notes}
  foot="Sources: FPDS and USAspending contract actions and subawards; SAM.gov entities and exclusions; SBA certification lists."
>
  <div class="wf-toolbar">
    <span class="wf-select">Awards <b>FY2021 to FY2026</b></span>
    <span class="wf-select">Program <b>All set-asides</b></span>
    <span class="wf-select">Market <b>NAICS 541330</b></span>
    <span class="wf-select">Office <b>All DoD</b></span>
    <span class="spacer"></span>
    <span class="wf-btn">Run back-test</span>
    <span class="wf-btn solid">Export lead package</span>
  </div>
  <div class="wf-body">
    <div class="wf-cols">
      <div class="wf-panel">
        <span class="co">1</span>
        <h4>Ranked vendors · 1,284 in market</h4>
        <table class="wf-table">
          <thead>
            <tr><th>Vendor</th><th class="num hide-sm">Set-aside awards</th><th>Score</th><th>Signals</th></tr>
          </thead>
          <tbody>
            {
              rows.map((r, i) => (
                <tr class={i === 0 ? 'sel' : undefined}>
                  <td class="mono">{r.id}<span class="sub2">{r.prog} · since {r.reg}</span></td>
                  <td class="num hide-sm">{r.amt}</td>
                  <td>
                    <span class="score" style={`--w:${r.score}%;--c:${r.score >= 80 ? 'var(--risk-hi)' : 'var(--risk-md)'}`}>
                      {r.score}<i />
                    </span>
                  </td>
                  <td>
                    <div class="chips">
                      {r.sig.map((x) => (
                        <span class={/Excluded|subawarded/.test(x) ? 'chip hot' : 'chip'}>{x}</span>
                      ))}
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="wf-panel">
        <span class="co">2</span>
        <h4>V-7A31 timeline</h4>
        <svg viewBox="0 0 420 150" aria-hidden="true">
          <line x1="20" y1="70" x2="400" y2="70" stroke="#c3cfdf" stroke-width="2" />
          {
            [
              { x: 62, t: 'SAM.gov registration', d: 'Feb 2021', up: true },
              { x: 120, t: '8(a) certified', d: 'Aug 2021', up: false },
              { x: 185, t: 'First award $12.0M', d: 'Jan 2022', up: true, hot: true },
              { x: 290, t: 'Mod growth +140%', d: 'Mar 2024', up: false, hot: true },
              { x: 368, t: 'Award $19.6M', d: 'Jun 2025', up: true },
            ].map((e) => (
              <g font-size="10" fill="#263043">
                <circle cx={e.x} cy="70" r="6" fill={e.hot ? 'var(--risk-hi)' : 'var(--geomid)'} stroke="#fff" stroke-width="2" />
                <text x={e.x} y={e.up ? 40 : 102} text-anchor="middle" font-weight="600">{e.t}</text>
                <text x={e.x} y={e.up ? 53 : 115} text-anchor="middle" fill="#6b7587">{e.d}</text>
              </g>
            ))
          }
        </svg>
        <div class="peer"><span>First large award after</span><span class="bar" style="--w:18%;--p:62%"><span></span><em></em></span><b>11 mo</b></div>
        <div class="peer"><span>Modification growth</span><span class="bar" style="--w:80%;--p:22%"><span></span><em></em></span><b>+140%</b></div>
        <p class="sub" style="margin:6px 0 0">Black tick: median for 8(a) firms in the same market.</p>
      </div>
    </div>

    <div class="wf-cols">
      <div class="wf-panel">
        <span class="co">3</span>
        <h4>Where V-7A31's award dollars go</h4>
        <svg viewBox="0 0 420 190" aria-hidden="true">
          <rect x="10" y="40" width="96" height="110" rx="5" fill="var(--navy)" />
          <text x="58" y="88" fill="#fff" font-size="11" text-anchor="middle" font-weight="600">V-7A31</text>
          <text x="58" y="104" fill="#cdd3e0" font-size="10" text-anchor="middle">$48.2M prime</text>
          <path d="M106 40 C200 40 210 20 300 20 L300 109 C210 109 200 129 106 129 Z" fill="rgba(181,71,58,0.28)" />
          <path d="M106 129 C200 129 210 122 300 122 L300 138 C210 138 200 140 106 140 Z" fill="rgba(95,143,191,0.35)" />
          <path d="M106 140 C200 140 210 152 300 152 L300 162 C210 162 200 150 106 150 Z" fill="rgba(105,115,128,0.3)" />
          <g font-size="10.5" fill="#263043">
            <rect x="300" y="20" width="8" height="89" fill="var(--risk-hi)" />
            <text x="314" y="56" font-weight="600">L-220 (large firm)</text>
            <text x="314" y="70" fill="#6b7587">81% · not eligible</text>
            <rect x="300" y="122" width="8" height="16" fill="var(--risk-lo)" />
            <text x="314" y="134">Other subs 11%</text>
            <rect x="300" y="152" width="8" height="10" fill="#697380" />
            <text x="314" y="161">Self-performed 8%</text>
          </g>
          <line x1="300" y1="64" x2="250" y2="64" stroke="var(--wf-ink)" stroke-dasharray="3 3" />
          <text x="150" y="178" font-size="10" fill="#6b7587">Shared POC phone and address with L-220 in SAM.gov</text>
        </svg>
      </div>
      <div class="wf-panel">
        <span class="co">4</span>
        <h4>Bidder ring B-3 · shared control and win rotation</h4>
        <svg viewBox="0 0 420 120" aria-hidden="true">
          <g stroke="#9fb0c9" stroke-width="1.4">
            <line x1="60" y1="60" x2="160" y2="30" /><line x1="60" y1="60" x2="160" y2="92" /><line x1="160" y1="30" x2="160" y2="92" />
          </g>
          <g font-size="10" fill="#263043">
            <circle cx="60" cy="60" r="16" fill="var(--risk-hi)" /><text x="60" y="64" fill="#fff" text-anchor="middle">A</text>
            <circle cx="160" cy="30" r="16" fill="var(--risk-md)" /><text x="160" y="34" fill="#fff" text-anchor="middle">B</text>
            <circle cx="160" cy="92" r="16" fill="var(--geoblue)" /><text x="160" y="96" fill="#fff" text-anchor="middle">C</text>
            <text x="70" y="30" fill="#6b7587">same officer</text>
            <text x="70" y="104" fill="#6b7587">same address</text>
            <text x="166" y="64" fill="#6b7587">same phone</text>
            <text x="232" y="22" font-weight="600">Winner by quarter, FY2023 to FY2025</text>
            {rotation.map((w, i) => (
              <g>
                <rect x={232 + i * 15} y="32" width="13" height="26" rx="2" fill={rotColor[w]} />
                <text x={238.5 + i * 15} y="72" text-anchor="middle" fill="#6b7587" font-size="9">{w}</text>
              </g>
            ))}
            <text x="232" y="92" fill="#6b7587">Each firm wins every third award;</text>
            <text x="232" y="106" fill="#6b7587">losing bids run 6 to 9% higher.</text>
          </g>
        </svg>
      </div>
    </div>

    <div class="wf-panel">
      <span class="co">5</span>
      <h4>Sole-source awards by value · this market</h4>
      <svg class="hist" viewBox="0 0 420 130" aria-hidden="true">
        {
          bins.map((b, i) => (
            <rect x={20 + i * binW} y={110 - b * 3} width={binW - 4} height={b * 3} fill={i === 9 ? 'var(--risk-hi)' : '#9fb0c9'} rx="2" />
          ))
        }
        <line x1={20 + 10 * binW - 2} x2={20 + 10 * binW - 2} y1="8" y2="112" stroke="var(--wf-ink)" stroke-dasharray="4 3" />
        <text x={24 + 10 * binW} y="20" font-size="10" fill="#263043">Sole-source threshold</text>
        <text x={20 + 9 * binW - 70} y="10" font-size="10" fill="var(--risk-hi)" font-weight="600">2.6× expected</text>
        <line x1="16" x2="390" y1="111" y2="111" stroke="#c3cfdf" />
        <text x="16" y="125" font-size="9.5" fill="#6b7587">Award value →</text>
      </svg>
      <div class="pk"><span class="co in">6</span> 3 vendors selected · <b>Add to lead package</b></div>
    </div>
  </div>
</Frame>

<style>
  .hist {
    max-width: 620px;
  }
  .pk {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--geomid);
    margin-top: 8px;
  }
  .co.in {
    position: static;
    box-shadow: none;
  }
</style>
