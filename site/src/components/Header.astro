---
import { url } from '../lib/content';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const nav = [
  { key: 'scorecard', label: 'Scorecard', href: url() },
  { key: 'agencies', label: 'Agency plans', href: url('agencies/') },
  { key: 'plan', label: 'Roadmap', href: url('plan/') },
  { key: 'pitches', label: 'Pitches', href: url('pitches/') },
  { key: 'case-study', label: 'SBA case study', href: url('case-study/sba/') },
  { key: 'tools', label: 'Tools', href: url('tools/') },
  { key: 'library', label: 'Research library', href: url('library/') },
];
---

<div class="utility">
  <div class="container">
    <span>The Geodesic Accountability Office · an independent analysis by Geodesic Solutions</span>
    <span class="right"><span class="draft">Draft for discussion · Public data only · No findings yet</span><a class="dl" href={url('downloads/')} aria-current={current === 'downloads' ? 'page' : undefined}>Downloads</a></span>
  </div>
</div>
<header class="site-header">
  <div class="container bar">
    <a href={url()} class="logo" aria-label="The Geodesic Accountability Office home">
      <img class="icon" src={url('images/icon.png')} alt="" width="388" height="353" />
      <span class="product"><span class="the">The</span> Geodesic<br />Accountability Office</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <form class="search" role="search" action={url('search/')} method="get">
      <label class="sr-only" for="site-search">Search the site</label>
      <input id="site-search" type="search" name="q" placeholder="Search" autocomplete="off" />
      <button type="submit" aria-label="Search">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
  </div>
</header>

<style>
  .utility {
    background: var(--navy-deep);
    color: #aeb6c8;
    font-size: 0.78rem;
  }
  .utility .container {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
  }
  .draft {
    color: #d9c08e;
  }
  .right {
    display: inline-flex;
    gap: 16px;
  }
  .dl {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .dl:hover,
  .dl[aria-current='page'] {
    text-decoration: underline;
  }
  .site-header {
    background: var(--navy);
    border-bottom: 3px solid var(--geogold);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 84px;
    flex-wrap: wrap;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 14px 0;
  }
  .icon {
    height: 44px;
    width: auto;
  }
  .product {
    font-family: var(--font-display);
    color: #fff;
    font-size: 1.32rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }
  .the {
    font-size: 0.8em;
    color: #cdd3e0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 30px 13px 27px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: #cdd3e0;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
  }
  nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }
  nav a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--geoblue);
  }
  .search {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius);
  }
  .search input {
    width: 150px;
    background: transparent;
    border: 0;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    padding: 7px 4px 7px 12px;
  }
  .search input::placeholder {
    color: #aeb6c8;
  }
  .search input:focus {
    outline: none;
  }
  .search:focus-within {
    border-color: var(--geogold);
    box-shadow: 0 0 0 2px var(--geogold);
  }
  .search button {
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    color: #cdd3e0;
    padding: 7px 10px;
    cursor: pointer;
  }
  .search button:hover {
    color: #fff;
  }
  @media (max-width: 900px) {
    .search {
      width: 100%;
      order: 2;
    }
    .search input {
      flex: 1;
    }
    .bar {
      padding-bottom: 6px;
    }
    nav {
      width: 100%;
      overflow-x: auto;
    }
    ul {
      flex-wrap: nowrap;
    }
    nav a {
      padding: 10px 12px;
      white-space: nowrap;
    }
    .utility .draft {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .product {
      font-size: 1.1rem;
    }
  }
</style>
