---
import { url } from '../lib/content';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const nav = [
  { key: 'scorecard', label: 'Scorecard', href: url() },
  { key: 'agencies', label: 'Agency plans', href: url('agencies/') },
  { key: 'plan', label: 'Roadmap', href: url('plan/') },
  { key: 'pitches', label: 'Pitches', href: url('pitches/') },
  { key: 'case-study', label: 'SBA case study', href: url('case-study/sba/') },
  { key: 'tools', label: 'Tools', href: url('tools/') },
  { key: 'library', label: 'Research library', href: url('library/') },
];
const more = [
  { key: 'investigations', label: 'All investigations', href: url('investigations/') },
  { key: 'schedule', label: 'Phase 1 schedule', href: url('schedule/') },
  { key: 'matrix', label: 'Priority matrix', href: url('agencies/matrix/') },
  { key: 'compare', label: 'Compare agencies', href: url('agencies/compare/') },
  { key: 'glossary', label: 'Glossary', href: url('glossary/') },
  { key: 'updates', label: "What's new", href: url('updates/') },
];
const inMore = more.some((m) => m.key === current);
---

<div class="utility">
  <div class="container">
    <span>The Geodesic Accountability Office · an independent analysis by Geodesic Solutions</span>
    <div class="right">
      <span class="draft">Draft for discussion · Public data only · No findings yet</span>
      <form class="search" role="search" action={url('search/')} method="get">
        <label class="sr-only" for="site-search">Search the site</label>
        <input id="site-search" type="search" name="q" placeholder="Search" autocomplete="off" />
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
            <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </form>
      <a class="dl" href={url('downloads/')} aria-current={current === 'downloads' ? 'page' : undefined}>Downloads</a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container bar">
    <a href={url()} class="logo" aria-label="The Geodesic Accountability Office home">
      <img class="icon" src={url('images/icon.png')} alt="" width="388" height="353" />
      <span class="product"><span class="the">The</span> Geodesic<br />Accountability Office</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="more">
          <details>
            <summary aria-current={inMore ? 'page' : undefined}>More</summary>
            <ul class="menu">
              {more.map((m) => (
                <li>
                  <a href={m.href} aria-current={current === m.key ? 'page' : undefined}>{m.label}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const d = document.querySelector<HTMLDetailsElement>('.site-header .more details');
  if (d) {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        d.open = false;
        d.querySelector('summary')!.focus();
      }
    });
  }
</script>

<style>
  .utility {
    background: var(--navy-deep);
    color: #aeb6c8;
    font-size: 0.78rem;
  }
  .utility .container {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
  }
  .draft {
    color: #d9c08e;
  }
  .dl {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .dl:hover,
  .dl[aria-current='page'] {
    text-decoration: underline;
  }
  .site-header {
    background: var(--navy);
    border-bottom: 3px solid var(--geogold);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 84px;
    flex-wrap: wrap;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 14px 0;
  }
  .icon {
    height: 44px;
    width: auto;
  }
  .product {
    font-family: var(--font-display);
    color: #fff;
    font-size: 1.32rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }
  .the {
    font-size: 0.8em;
    color: #cdd3e0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 30px 13px 27px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: #cdd3e0;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
  }
  nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }
  .more {
    position: relative;
  }
  summary {
    display: block;
    padding: 30px 13px 27px;
    font-weight: 500;
    font-size: 0.95rem;
    color: #cdd3e0;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: ' ▾';
    font-size: 0.8em;
  }
  summary:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }
  summary[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--geoblue);
  }
  .menu {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 60;
    flex-direction: column;
    flex-wrap: nowrap;
    min-width: 220px;
    background: var(--navy);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-top: 3px solid var(--geogold);
    border-radius: 0 0 6px 6px;
    padding: 6px 0;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }
  .menu a {
    padding: 8px 16px;
    border-bottom: 0;
    margin: 0;
    white-space: nowrap;
  }
  .menu a[aria-current='page'] {
    border-left: 3px solid var(--geoblue);
    padding-left: 13px;
  }
  nav a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--geoblue);
  }
  .utility .container {
    align-items: center;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .search {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 4px;
  }
  .search input {
    width: 170px;
    background: transparent;
    border: 0;
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    padding: 3px 4px 3px 10px;
  }
  .search input::placeholder {
    color: #aeb6c8;
  }
  .search input:focus {
    outline: none;
  }
  .search:focus-within {
    border-color: var(--geogold);
    box-shadow: 0 0 0 2px var(--geogold);
  }
  .search button {
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    color: #cdd3e0;
    padding: 3px 8px;
    cursor: pointer;
  }
  .search button:hover {
    color: #fff;
  }
  @media (max-width: 900px) {
    .bar {
      padding-bottom: 6px;
    }
    nav {
      width: 100%;
    }
    nav a,
    summary {
      padding: 10px 12px;
      white-space: nowrap;
    }
    .menu {
      position: absolute;
      right: auto;
      left: 0;
    }
    .utility .draft {
      display: none;
    }
    .utility .container > span {
      display: none;
    }
    .right,
    .search {
      flex: 1;
    }
    .search input {
      flex: 1;
      width: auto;
      font-size: 0.9rem;
      padding: 6px 4px 6px 10px;
    }
  }
  @media (max-width: 520px) {
    .product {
      font-size: 1.1rem;
    }
  }
</style>
