---
// "On this page" contents list for long pages. Items link to heading ids.
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 2 && (
    <nav class="otp facts no-print" aria-label="On this page">
      <h3>On this page</h3>
      <ol>
        {items.map((i) => (
          <li>
            <a href={`#${i.id}`}>{i.label}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .otp ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .otp a {
    text-decoration: none;
  }
  .otp a:hover,
  .otp a[aria-current='true'] {
    text-decoration: underline;
  }
  .otp a[aria-current='true'] {
    font-weight: 650;
    color: var(--coolblack);
  }
</style>
