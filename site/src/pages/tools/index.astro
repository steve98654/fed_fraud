---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { tools } from '../../data/tools';
import { agencies, url, fmtDate, weekEnd } from '../../lib/content';

const list = agencies();
---

<Base title="Tool previews" section="tools">
  <PageTitle
    eyebrow="Tool previews · Wireframes"
    title="What agencies would get from the first prototypes"
    lead="Wireframes of the detection screens for three of the ten investigations we start first. They show agency leaders the working tool behind each lead package: a ranked list, the reasons for every score, and the network or money trail behind it."
    crumbs={[{ label: 'Scorecard', href: url() }]}
  />

  <section class="section">
    <div class="container">
      <p class="notice">
        <span>
          <strong>Sample data only.</strong> Every provider, store and vendor in these wireframes is made up. Scores and
          amounts are illustrative, not findings. Savings stay "Pending" on the scorecard until a screen passes validation.
        </span>
      </p>
      <div class="cards">
        {
          tools.map((t) => {
            const a = list.find((x) => x.slug === t.agency)!;
            return (
              <a class="card" href={url(`tools/${t.slug}/`)}>
                <div class="top">
                  <span class="agency">{a.short} · priority {a.rank}</span>
                  <span class="ids">
                    {t.ideas.map((id) => (
                      <span class="id-chip">{id}</span>
                    ))}
                  </span>
                </div>
                <h2>{t.title}</h2>
                <p>{t.summary}</p>
                <div class="meta">
                  <span class="badge planned">Prototype due {fmtDate(weekEnd(a.endWeek))}</span>
                  <span class="go">View wireframe →</span>
                </div>
              </a>
            );
          })
        }
      <a class="card benford" href={url('tools/benford/')}>
        <div class="top">
          <span class="agency">All agencies · universal screen U1</span>
          <span class="ids"><span class="id-chip">U1</span></span>
        </div>
        <h2>Benford checker (working prototype)</h2>
        <p>
          Paste a column of amounts and test it against Benford's law with the handbook's formulas and thresholds: MAD
          conformity, chi-square and digit spikes. Runs in the browser; nothing is uploaded.
        </p>
        <div class="meta">
          <span class="badge planned">Working now</span>
          <span class="go">Open the checker →</span>
        </div>
      </a>
      </div>
      <p class="more">
        The same screen pattern (rank, explain, show the network, export a lead package) carries over to the other roadmap
        investigations. See the <a href={url('plan/')}>roadmap</a> for the full list.
      </p>
    </div>
  </section>
</Base>

<style>
  .notice {
    margin: 0 0 28px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--geomid);
    border-radius: var(--radius);
    background: #fff;
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .card:hover {
    box-shadow: 0 10px 28px rgba(0, 46, 99, 0.1);
    transform: translateY(-2px);
    color: var(--ink);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .agency {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--geomid);
  }
  .ids {
    display: flex;
    gap: 5px;
  }
  h2 {
    font-size: 1.3rem;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    flex: 1;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .go {
    font-weight: 600;
    color: var(--geomid);
    font-size: 0.9rem;
  }
  .more {
    margin-top: 28px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
