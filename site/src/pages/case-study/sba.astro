---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import DocBody from '../../components/DocBody.astro';
import { url, doc, REPO } from '../../lib/content';

const d = doc('playbook/sba-case-study.md');
const bottom = d.sections.find((s) => s.heading === 'Bottom line');
const rest = d.sections.filter((s) => s !== bottom);
---

<Base
  title="SBA case study"
  section="case-study"
  description="How the SBA fraud work with Rosemary finds pandemic loan fraud in public data, and why the same method carries over to other agencies."
>
  <PageTitle
    eyebrow="Case study · Small Business Administration"
    title={d.title.replace(/^SBA case study:\s*/, 'SBA: ')}
    lead="How the SBA fraud work finds pandemic loan fraud in public data, and why the same method carries over to the other 32 agencies."
    crumbs={[{ label: 'Scorecard', href: url() }]}
  >
    <button class="btn no-print" type="button" onclick="window.print()">Print or save as PDF</button>
  </PageTitle>

  <section class="section">
    <div class="container layout">
      <article>
        {bottom && <div class="bottom prose" set:html={bottom.html} />}
        <DocBody sections={rest} callouts={['Results']} />
      </article>
      <aside>
        <div class="facts">
          <h3>Case study status</h3>
          <dl>
            <div>
              <dt>Method</dt>
              <dd>Drafted from the SBA brief and review plan</dd>
            </div>
            <div>
              <dt>Measured results</dt>
              <dd><span class="badge pending">Pending</span></dd>
            </div>
            <div>
              <dt>Results from</dt>
              <dd>The SBA team (Rosemary), checked before publication</dd>
            </div>
            <div>
              <dt>Full playbook</dt>
              <dd>Week 2 (item F1), <code>docs/playbook/sba-baseline.md</code></dd>
            </div>
          </dl>
        </div>
        <div class="facts no-print">
          <h3>Where it goes next</h3>
          <ul class="links">
            <li><a href={url('pitches/sba-1/')}>SBA-1 pitch: 7(a), 504 and 8(a)</a></li>
            <li><a href={url('pitches/')}>All ten one-page pitches</a></li>
            <li><a href={url('library/methodology/')}>Methodology</a></li>
            <li><a href={url('agencies/sba/')}>SBA agency plan</a></li>
            <li>
              <a href={`${REPO}/blob/main/docs/playbook/sba-case-study.md`} target="_blank" rel="noopener">Source in the repository</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: start;
  }
  aside {
    display: grid;
    gap: 18px;
  }
  .bottom {
    font-size: 1.08rem;
    border-left: 4px solid var(--geomid);
    padding: 4px 0 4px 20px;
    margin-bottom: 36px;
  }
  .links {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    font-size: 0.92rem;
  }
  code {
    font-size: 0.8rem;
    word-break: break-all;
  }
  button.btn {
    font-family: inherit;
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
