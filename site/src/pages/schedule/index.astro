---
// Gantt-style Phase 1 schedule: each agency's review window across the 16
// working weeks, with milestones and the holiday break. Built from the
// roadmap's "When" column and milestones table.
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { agencies, roadmap, url, fmtDate, weekStart, weekEnd, GROUPS, groupLabel } from '../../lib/content';
import { weeksLabel } from '../../lib/format';
import { asOf } from '../../data/scorecard';

const WEEKS = 16;
const weeks = Array.from({ length: WEEKS }, (_, i) => i + 1);
const list = agencies();
const road = roadmap();
const day = (s: string) => new Date(`${s}T12:00:00Z`);
// Week a date falls in (dates in the holiday break or a weekend after a week
// belong to the week before).
const weekOf = (d: Date) => {
  let n = 0;
  for (const w of weeks) if (weekStart(w) <= d) n = w;
  return n;
};
const milestones = road.milestones.map((m) => ({ ...m, week: weekOf(day(m.date)) }));
const breakAfter = weeks.find((w) => w < WEEKS && +weekStart(w + 1) - +weekStart(w) > 7 * 864e5) ?? 0;
const today = day(asOf);
const todayWeek = today < weekStart(1) ? 0 : weekOf(today);
const groups = GROUPS.map((g) => ({ g, items: list.filter((a) => a.group === g).sort((x, y) => x.startWeek - y.startWeek || x.rank - y.rank) }));
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Phase 1 schedule"
  section="schedule"
  description="Phase 1 schedule: each agency's review window across the sixteen working weeks, with milestones."
>
  <PageTitle
    eyebrow="Roadmap · Schedule"
    title="Phase 1 schedule"
    lead={`Sixteen working weeks from ${fmtDate(weekStart(1))} to ${fmtDate(weekEnd(WEEKS))}. Each bar is an agency's review window from the roadmap; gold lines mark milestones.`}
    crumbs={[{ label: 'Scorecard', href: url() }, { label: 'Roadmap', href: url('plan/') }]}
  />

  <section class="section">
    <div class="container">
      <ul class="legend" aria-label="Legend">
        {GROUPS.map((g, i) => <li><span class={`sw g${i}`} aria-hidden="true" />{groupLabel(g)}</li>)}
        <li><span class="sw ms" aria-hidden="true" />Milestone</li>
        {breakAfter > 0 && <li><span class="sw brk" aria-hidden="true" />Holiday break</li>}
      </ul>

      <div class="scroll" tabindex="0" role="region" aria-label="Phase 1 schedule chart, scrolls sideways on small screens">
        <div class="gantt" style={`--weeks:${WEEKS}`}>
          <div class="hdr label" aria-hidden="true">Agency</div>
          {
            weeks.map((w) => (
              <div class:list={['hdr', { now: w === todayWeek, brk: w === breakAfter }]} aria-hidden="true">
                <span class="wk">W{w}</span>
                <span class="dt">{month(weekStart(w))}</span>
              </div>
            ))
          }
          {
            groups.map(({ g, items }, gi) => (
              <>
                <div class="grp" style={`grid-column: 1 / -1`}>
                  <h2>{groupLabel(g)}</h2>
                </div>
                {items.map((a) => (
                  <>
                    <div class="label">
                      <a href={url(`agencies/${a.slug}/`)}>{a.short}</a>
                      {a.startFirst && <span class="star" title="Has a start-first investigation">★<span class="sr-only"> start first</span></span>}
                    </div>
                    <div class="lane" style={`grid-column: 2 / -1`}>
                      {weeks.map((w) => (
                        <span class:list={['cell', { brk: w === breakAfter, ms: milestones.some((m) => m.week === w) }]} style={`grid-column:${w}`} aria-hidden="true" />
                      ))}
                      {a.startWeek > 0 && (
                        <span class={`bar g${gi}`} style={`grid-column:${a.startWeek} / ${a.endWeek + 1}`}>
                          <span class="ids">{a.ideas.map((i) => i.id).join(' · ')}</span>
                          <span class="sr-only">
                            {`: ${weeksLabel(a.startWeek, a.endWeek)}, ${fmtDate(weekStart(a.startWeek))} to ${fmtDate(weekEnd(a.endWeek))}`}
                          </span>
                        </span>
                      )}
                    </div>
                  </>
                ))}
              </>
            ))
          }
        </div>
      </div>
      {breakAfter > 0 && (
        <p class="note">
          The holiday break ({fmtDate(new Date(+weekEnd(breakAfter) + 3 * 864e5))} to{' '}
          {fmtDate(new Date(+weekStart(breakAfter + 1) - 3 * 864e5))}) falls between week {breakAfter} and week {breakAfter + 1}.
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Milestones</span>
          <h2>Dates the program reports against</h2>
        </div>
        <a class="btn" href={url('plan/milestones/')}>Roadmap page 5: milestones</a>
      </div>
      <ol class="ms-list">
        {
          milestones.map((m) => (
            <li class:list={{ past: day(m.date) < today }}>
              <span class="date">{fmtDate(m.date)}</span>
              <span class="wk">Week {m.week || '—'}</span>
              <span class="text">{m.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .legend {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sw {
    width: 22px;
    height: 12px;
    border-radius: 3px;
  }
  .g0 { background: var(--geomid); color: #fff; }
  .g1 { background: var(--geoblue); color: #fff; }
  .g2 { background: #4f6b52; color: #fff; }
  .g3 { background: var(--geogray); color: #fff; }
  .sw.ms {
    width: 3px;
    height: 16px;
    background: var(--geogold);
  }
  .sw.brk {
    background: repeating-linear-gradient(45deg, #fff 0 3px, var(--georule) 3px 6px);
    border: 1px solid var(--georule);
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .gantt {
    display: grid;
    grid-template-columns: 110px repeat(var(--weeks), minmax(44px, 1fr));
    min-width: 860px;
    font-size: 0.8rem;
  }
  .hdr {
    background: var(--geodark);
    color: #fff;
    padding: 8px 4px;
    text-align: center;
    line-height: 1.2;
    position: sticky;
    top: 0;
  }
  .hdr.label {
    text-align: left;
    padding-left: 12px;
    font-weight: 600;
  }
  .hdr.now {
    background: var(--geogold);
    color: #1d2433;
  }
  .hdr .wk {
    display: block;
    font-weight: 650;
  }
  .hdr .dt {
    font-size: 0.7rem;
    opacity: 0.85;
  }
  .grp {
    background: var(--geolight);
    border-top: 1px solid var(--line);
    padding: 6px 12px;
  }
  .grp h2 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--geomid);
  }
  .label {
    padding: 6px 12px;
    border-top: 1px solid var(--line);
    font-weight: 600;
    white-space: nowrap;
  }
  .label a {
    text-decoration: none;
  }
  .label a:hover {
    text-decoration: underline;
  }
  .star {
    color: var(--gold-ink);
    margin-left: 4px;
  }
  .lane {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(44px, 1fr));
    border-top: 1px solid var(--line);
    position: relative;
  }
  .cell {
    grid-row: 1;
    border-left: 1px solid var(--line);
  }
  .cell.ms {
    border-right: 3px solid var(--geogold);
  }
  .cell.brk {
    border-right: 6px solid transparent;
    border-image: repeating-linear-gradient(45deg, #fff 0 3px, var(--georule) 3px 6px) 6;
  }
  .bar {
    grid-row: 1;
    position: relative;
    z-index: 1;
    margin: 5px 2px;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .note {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 10px;
  }
  .ms-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .ms-list li {
    display: grid;
    grid-template-columns: 130px 80px 1fr;
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .ms-list li:first-child {
    border-top: 0;
  }
  .ms-list .date {
    font-weight: 650;
    color: var(--coolblack);
  }
  .ms-list .wk {
    color: var(--muted);
  }
  .ms-list li.past .text {
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .ms-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  @media print {
    .scroll {
      overflow: visible;
    }
    .gantt {
      min-width: 0;
    }
  }
</style>
