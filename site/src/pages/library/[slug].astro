---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import Placeholder from '../../components/Placeholder.astro';
import DocBody from '../../components/DocBody.astro';
import { library } from '../../data/library';
import { url, fmtDate, weekEnd, REPO, doc, docExists, mdInline } from '../../lib/content';

export function getStaticPaths() {
  return library.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const rel = d.source.replace(/^docs\//, '');
const written = d.status && docExists(rel) ? doc(rel) : undefined;
const bottom = written?.sections.find((s) => s.heading === 'Bottom line');
const body = written?.sections.filter((s) => s !== bottom) ?? [];
---

<Base title={d.title} section="library" description={d.summary}>
  <PageTitle
    eyebrow={`Section 4 · ${d.kind}`}
    title={d.title}
    lead={d.summary}
    crumbs={[
      { label: 'Scorecard', href: url() },
      { label: 'Research library', href: url('library/') },
    ]}
  />
  <section class="section">
    <div class="container layout">
      {
        written ? (
          <article>
            {written.status && <p class="status" set:html={mdInline(written.status)} />}
            {bottom && <div class="bottom prose" set:html={bottom.html} />}
            <nav class="toc" aria-label="Contents">
              <span>Contents</span>
              <ol>
                {body.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>{s.heading.replace(/^\d+\.\s*/, '')}</a>
                  </li>
                ))}
              </ol>
            </nav>
            <DocBody sections={body} callouts={['7.']} />
          </article>
        ) : (
          <Placeholder outline={d.outline} />
        )
      }
      <aside class="facts">
        <h3>Document status</h3>
        <dl>
          <div>
            <dt>Status</dt>
            <dd>
              {written ? (
                <span class="badge planned">{d.status}</span>
              ) : (
                <span class="badge placeholder">Placeholder</span>
              )}
            </dd>
          </div>
          {
            !written && (
              <div>
                <dt>Due</dt>
                <dd>
                  Week {d.dueWeek} · {fmtDate(weekEnd(d.dueWeek))}
                </dd>
              </div>
            )
          }
          <div>
            <dt>Review plan items</dt>
            <dd>{d.planIds.join(', ')}</dd>
          </div>
          <div>
            <dt>{written ? 'Source file' : 'Source file (when written)'}</dt>
            <dd>
              {written ? (
                <a href={`${REPO}/blob/main/${d.source}`} target="_blank" rel="noopener">
                  <code>{d.source}</code>
                </a>
              ) : (
                <code>{d.source}</code>
              )}
            </dd>
          </div>
          <div>
            <dt>Planned in</dt>
            <dd><a href={`${REPO}/blob/main/docs/review_plan.md`} target="_blank" rel="noopener">Review plan</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    align-items: start;
  }
  code {
    font-size: 0.82rem;
    word-break: break-all;
  }
  .status {
    margin: 0 0 20px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .bottom {
    font-size: 1.05rem;
    border-left: 4px solid var(--geomid);
    padding: 4px 0 4px 20px;
    margin-bottom: 28px;
  }
  .toc {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 20px;
    margin-bottom: 36px;
    font-size: 0.92rem;
  }
  .toc span {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--geomid);
  }
  .toc ol {
    margin: 8px 0 0;
    padding-left: 20px;
    columns: 2;
    column-gap: 32px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .toc ol {
      columns: 1;
    }
  }
</style>
