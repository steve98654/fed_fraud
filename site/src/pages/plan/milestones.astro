---
import PlanShell from '../../components/PlanShell.astro';
import { roadmap, md, fmtDate } from '../../lib/content';
import { asOf } from '../../data/scorecard';
const r = roadmap();
const today = new Date(`${asOf}T12:00:00Z`);
---

<PlanShell
  page={5}
  lead="The dated milestones from FOIA filing to the Phase 1 report, with a result column that fills in as each one lands, followed by the risks and open decisions."
  resultsDue="March 5, 2027 (Phase 1 report and leadership briefing)"
  resultsText="Each milestone's outcome will be recorded in the table below as it is reached."
>
  <div class="section-head">
    <div>
      <span class="eyebrow">Phase 1 calendar</span>
      <h2>Milestones and results</h2>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Milestone</th>
          <th>Status</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody>
        {
          r.milestones.map((m) => (
            <tr>
              <td class="date">{fmtDate(m.date)}</td>
              <td>{m.text}</td>
              <td>
                <span class="badge planned">{new Date(`${m.date}T12:00:00Z`) < today ? 'Due' : 'Upcoming'}</span>
              </td>
              <td>
                <span class="badge pending">Pending</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="risks">
    <div class="prose" set:html={md('## Risks and decisions\n\n' + r.get('Risks and decisions'), '')} />
  </div>
</PlanShell>

<style>
  .date {
    white-space: nowrap;
    font-weight: 600;
    color: var(--coolblack);
  }
  .risks {
    margin-top: 40px;
  }
</style>
