---
import '@fontsource/trirong/300.css';
import '@fontsource/trirong/400.css';
import '@fontsource/trirong/500.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  section?: 'scorecard' | 'agencies' | 'plan' | 'library';
}
const SITE = 'Federal Fraud Scorecard';
const {
  title,
  section,
  description = 'Geodesic Solutions scorecard and plans for finding fraud across the 33 largest federal agencies, extending the SBA work.',
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : `${SITE} | Geodesic Solutions`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header current={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
