% geodesicbrand.sty
% Shared brand kit for every Geodesic Solutions template in this folder tree.
% Colors, identity, compile time stamp (UTC), geodesic graphics, logo slots,
% and the house footer. Works with article, letter and beamer.
%
% Load it from a template folder with:
%   \makeatletter\def\input@path{{../geodesic_brand/}}\makeatother
%   \usepackage{geodesicbrand}

\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{geodesicbrand.sty}[2026/10/11 Geodesic Solutions brand kit]

\@ifpackageloaded{xcolor}{}{\RequirePackage[table]{xcolor}}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,shapes.geometric,fadings}
\graphicspath{{./}{./images/}{../geodesic_brand/}{../geodesic_brand/surfaces/}}

% ------------------------------------------------------------------
% Palette. Blues are sampled from the Geodesic logo; coolblack and
% ultramarine come from the past proposals. Gold is an accent only.
% ------------------------------------------------------------------
\definecolor{geoblue}{RGB}{53,115,180}
\definecolor{geomid}{RGB}{33,81,124}
\definecolor{geodark}{RGB}{27,65,94}
\definecolor{geodeep}{RGB}{20,50,68}
\definecolor{coolblack}{rgb}{0.0,0.18,0.39}
\definecolor{ultramarine}{RGB}{0,32,96}
\definecolor{geolight}{RGB}{235,241,248}
\definecolor{geomist}{RGB}{246,249,252}
\definecolor{geogray}{RGB}{105,115,128}
\definecolor{georule}{RGB}{200,212,226}
\definecolor{geogold}{RGB}{184,146,74}

% ------------------------------------------------------------------
% Identity. Override any of these with \renewcommand in a template.
% ------------------------------------------------------------------
\newcommand{\geofirm}{Geodesic Solutions}
\newcommand{\geourl}{geodesic.pro}
\newcommand{\geoemail}{taylor@geodesic.pro}
\newcommand{\geosigner}{Steve Taylor}
\newcommand{\geosignertitle}{Managing Partner}
\newcommand{\geotagline}{Three practices, one discipline.}
\newcommand{\geoheadline}{Quantitative analysis of capital markets, strategy and policy decisions.}
\newcommand{\geopromise}{We navigate our clients from a challenging problem to a defensible solution along the shortest rigorous path.}
\newcommand{\geopractices}{Quantitative Finance \textperiodcentered{} Government Policy \textperiodcentered{} Venture Capital}
