% ------------------------------------------------------------------
% House typography rules: never hyphenate words across lines.
% ------------------------------------------------------------------
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em

% ------------------------------------------------------------------
% Compile time in UTC, read from pdfTeX's creation date
% (D:YYYYMMDDHHmmSS+HH'mm') and shifted by its time zone offset, so every
% machine prints the same UTC time.
%   \compiletime  ->  1:32am UTC on October 11th, 2026
%   \compiledate  ->  October 11th, 2026   (UTC calendar date)
% ------------------------------------------------------------------
\ExplSyntaxOn
\str_set:Nx \l_tmpa_str { \pdfcreationdate }
\cs_new:Npn \geo_field:nn #1#2 { \int_eval:n { \str_range:Nnn \l_tmpa_str {#1} {#2} } }
\int_new:N \g_geo_year_int  \int_new:N \g_geo_month_int \int_new:N \g_geo_day_int
\int_new:N \g_geo_min_int   \int_new:N \g_geo_off_int
\int_gset:Nn \g_geo_year_int  { \geo_field:nn {3} {6} }
\int_gset:Nn \g_geo_month_int { \geo_field:nn {7} {8} }
\int_gset:Nn \g_geo_day_int   { \geo_field:nn {9} {10} }
\int_gset:Nn \g_geo_min_int   { \geo_field:nn {11} {12} * 60 + \geo_field:nn {13} {14} }
\str_case:enF { \str_item:Nn \l_tmpa_str {17} }
  { {+} { \int_gset:Nn \g_geo_off_int { \geo_field:nn {18} {19} * 60 + \geo_field:nn {21} {22} } }
    {-} { \int_gset:Nn \g_geo_off_int { 0 - ( \geo_field:nn {18} {19} * 60 + \geo_field:nn {21} {22} ) } } }
  { \int_gset:Nn \g_geo_off_int { 0 } }
\int_gsub:Nn \g_geo_min_int { \g_geo_off_int }
\cs_new:Npn \geo_month_days: {
  \int_case:nnF { \g_geo_month_int } { {2} { \bool_lazy_and:nnTF
      { \int_compare_p:n { \int_mod:nn { \g_geo_year_int } {4} = 0 } }
      { \bool_lazy_or_p:nn { \int_compare_p:n { \int_mod:nn { \g_geo_year_int } {100} != 0 } }
                           { \int_compare_p:n { \int_mod:nn { \g_geo_year_int } {400} = 0 } } }
      {29} {28} } {4} {30} {6} {30} {9} {30} {11} {30} } {31} }
\int_compare:nNnT { \g_geo_min_int } < { 0 }
  { \int_gadd:Nn \g_geo_min_int { 1440 } \int_gdecr:N \g_geo_day_int
    \int_compare:nNnT { \g_geo_day_int } = { 0 }
      { \int_gdecr:N \g_geo_month_int
        \int_compare:nNnT { \g_geo_month_int } = { 0 }
          { \int_gset:Nn \g_geo_month_int {12} \int_gdecr:N \g_geo_year_int }
        \int_gset:Nn \g_geo_day_int { \geo_month_days: } } }
\int_compare:nNnT { \g_geo_min_int } > { 1439 }
  { \int_gsub:Nn \g_geo_min_int { 1440 } \int_gincr:N \g_geo_day_int
    \int_compare:nNnT { \g_geo_day_int } > { \geo_month_days: }
      { \int_gset:Nn \g_geo_day_int {1} \int_gincr:N \g_geo_month_int
        \int_compare:nNnT { \g_geo_month_int } = { 13 }
          { \int_gset:Nn \g_geo_month_int {1} \int_gincr:N \g_geo_year_int } } }
\cs_new:Npn \geo_hour: { \int_div_truncate:nn { \g_geo_min_int } {60} }
\cs_new:Npn \geo_suffix:n #1 { \int_case:nnF {#1} { {1}{st} {2}{nd} {3}{rd} {21}{st} {22}{nd} {23}{rd} {31}{st} } {th} }
\NewDocumentCommand \compiledate {}
  { \int_case:nn { \g_geo_month_int } { {1}{January} {2}{February} {3}{March} {4}{April} {5}{May} {6}{June}
      {7}{July} {8}{August} {9}{September} {10}{October} {11}{November} {12}{December} }
    \nobreakspace \int_use:N \g_geo_day_int \geo_suffix:n { \g_geo_day_int } , ~ \int_use:N \g_geo_year_int }
\NewDocumentCommand \compiletime {}
  { \int_eval:n { \int_mod:nn { \geo_hour: + 11 } {12} + 1 } :
    \int_compare:nNnT { \int_mod:nn { \g_geo_min_int } {60} } < {10} {0}
    \int_eval:n { \int_mod:nn { \g_geo_min_int } {60} }
    \int_compare:nNnTF { \geo_hour: } < {12} {am} {pm} \nobreakspace UTC~on~ \compiledate }
\ExplSyntaxOff

% ------------------------------------------------------------------
% Geodesics on surfaces. Smooth shaded renderings with numerically
% integrated geodesics drawn in metallic gold (#D4AF37), built by
% make_surfaces.py into surfaces/ (a .png, a standalone .tex and the
% compiled .pdf for every surface and palette):
%   \geosurface[<palette>]{<name>}{<width>}   \geosurfaceh[<palette>]{<name>}{<height>}
% names:    enneper, catenoid, scherk (minimal surfaces), umbilic (umbilic
%           torus), mountains (a ridgeline), relief (mountains from above)
% palettes: light (default), dark (for navy backgrounds), ink (navy line art)
% Roughly square except mountains (about 1.7 wide per 1 tall).
% ------------------------------------------------------------------
% Every surface is drawn slightly transparent so it supports the text instead
% of dominating the page. Change \geosurfaceopacity (0 to 1) to adjust all of them.
\RequirePackage{transparent}
\newcommand\geosurfaceopacity{0.75}
\newcommand\geosurface[3][light]{{\transparent{\geosurfaceopacity}\includegraphics[width=#3]{geosurf_#2_#1.pdf}}}
\newcommand\geosurfaceh[3][light]{{\transparent{\geosurfaceopacity}\includegraphics[height=#3]{geosurf_#2_#1.pdf}}}

% ------------------------------------------------------------------
% Logo and seal slots. If the file exists it is used; otherwise a clean
% placeholder is drawn so the template still compiles.
%   \geologo{<file>}{<width>}{<placeholder label>}
% ------------------------------------------------------------------
\newcommand\geologo[3]{%
  \IfFileExists{#1}%
    {\includegraphics[width=#2]{#1}}%
    {\tikz{\draw[geoblue,dashed,line width=0.6pt,fill=geomist] (0,0) circle ({#2/2});
           \node[anchor=center,align=center,text width={#2*0.75},font=\fontsize{6}{7}\selectfont\sffamily,
                 text=geomid] at (0,0) {#3};}}}

% Same, clipped to a circle on a white disc: for seals on dark backgrounds.
%   \geologoround{<file>}{<width>}{<placeholder label>}
\newcommand\geologoround[3]{%
  \IfFileExists{#1}%
    {\tikz[baseline={(0,-#2/2)}]{\fill[white] (0,0) circle ({#2/2});
      \begin{scope}\clip (0,0) circle ({#2/2*0.97});
        \node[inner sep=0pt,anchor=center] at (0,0) {\includegraphics[width=#2]{#1}};\end{scope}}}%
    {\geologo{#1}{#2}{#3}}}

% Brand mark: logo plus firm name.
\newcommand\geomark[1][1.1cm]{\includegraphics[width=#1]{icon.png}}

% ------------------------------------------------------------------
% House footer for article and letter documents (not beamer):
%   \pagestyle{geodesic}
% ------------------------------------------------------------------
\@ifclassloaded{beamer}{}{%
  \RequirePackage{fancyhdr}
  \RequirePackage{lastpage}
  \fancypagestyle{geodesic}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
    \fancyfoot[L]{%
      \parbox[b]{\dimexpr\linewidth-2.0cm\relax}{%
        \fontsize{8.5}{10}\selectfont\itshape
        Page \thepage\ of \pageref{LastPage}\\[-1pt]
        {\color{coolblack}\rule{\linewidth}{0.3pt}}\\[1pt]
        \geofirm: \geourl\hfill Contact: \geosigner, \geosignertitle: \geoemail}}%
    \fancyfoot[R]{\parbox[b]{1.6cm}{\hfill\includegraphics[width=1.1cm]{icon.png}}}}%
}

\endinput
